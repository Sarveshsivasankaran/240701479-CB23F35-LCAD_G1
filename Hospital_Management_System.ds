	reports
	{
		list medicine_prescription_Report
		{
			displayName = "Medicine Prescription Report"
			show all rows from medicine_prescription    
			(
				patient as "Patient"
				doctor as "Doctor"
				prescription as "Prescription"
				medicine_name as "Medicine Name"
				quantity as "Quantity"
				unit as "Unit"
				administration_route as "Administration Route"
				frequency as "Frequency"
				start_date as "Start Date"
				end_date as "End Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (administration_route == "Dermal")
				fields = [administration_route]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (administration_route == "Oral")
				fields = [administration_route]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
