 application "Student Information Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form academic_calendar
		{
			displayname = "Academic Calendar"
			success message = "Data Added Successfully!"
