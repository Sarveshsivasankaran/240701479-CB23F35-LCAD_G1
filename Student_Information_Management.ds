	reports
	{
		list course_registration_Report
		{
			displayName = "Course Registration Report"
			show all rows from course_registration    
			(
				student as "Student"
				course as "Course"
				registration_date as "Registration Date"
				status as "Status"
				semester as "Semester"
				enrollment_date as "Enrollment Date"
				priority as "Priority"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Completed")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Dropped")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (status == "Registered")
				fields = [status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (status == "Waitlisted")
				fields = [status]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban course_registration_by_semester
		{
			displayName = "Board"
			show all rows from course_registration    
			(
				student as "Student"
				course as "Course"
				registration_date as "Registration Date"
				status as "Status"
				semester as "Semester"
				enrollment_date as "Enrollment Date"
				priority as "Priority"
			)
			options
			(
	 			display field = semester
	 		)
		}
		list attendance_record_Report
		{
			displayName = "Attendance Record Report"
			show all rows from attendance_record    
			(
				student as "Student"
				course as "Course"
				date_1 as "Date"
				status as "Status"
				period as "Period"
				instructor as "Instructor"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (status == "Absent")
				fields = [status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (status == "Late")
				fields = [status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
