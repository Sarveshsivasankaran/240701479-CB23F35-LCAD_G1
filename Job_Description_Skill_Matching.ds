 application "Job Description Skill Matching"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Job_Post
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Company
			(
    			type = text
    			description
    			[
    				type = tooltip
    			 	message = "Company name"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Role
			(
    			type = text
    			description
    			[
    				type = tooltip
    			 	message = "Job role"
    			]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Job_Description
			(
    			type = textarea
				height = 100px
    			description
    			[
    				type = tooltip
    			 	message = "Full job description"
    			]
	 			row = 1
	 			column = 1   
				width = large
			)
			Keyword
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = Job_Description
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Skill_Match
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Student_Name
			(
    			type = text
				displayname = "Student Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Job_Post
			(
				type = picklist	
				displayname = "Job Post"
				values  = Job_Post.ID
    			displayformat = [Role]
	 			row = 1
	 			column = 1   
				width = medium
			)
			My_Skills
			(
				type = checkboxes	
				displayname = "My Skills"
				values = {"Java","Python","JavaScript","SQL","React","Node.js","AWS","Docker"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Match_Percentage
			(
    			type = percentage
				displayname = "Match Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Job_Post_Report
		{
			displayName = "Job_Post Report"
			show all rows from Job_Post    
			(
				Company
				Role
				Job_Description
				Keyword
			)
		}
		default list Skill_Match_Report
		{
			displayName = "Skill_Match Report"
			show all rows from Skill_Match    
			(
				Student_Name as "Student Name"
				Job_Post as "Job Post"
				My_Skills as "My Skills"
				Match_Percentage as "Match Percentage"
				(
					display = total	
				)
			)
		}
		list High_Skill_Matches
		{
			displayName = "High_Skill_Matches"
			show all rows from Skill_Match  [Match_Percentage > 60]  
			(
				Student_Name as "Student Name"
				Job_Post as "Job Post"
				My_Skills as "My Skills"
				Match_Percentage as "Match Percentage"
			)
		}
	}
	pages
	{
		page Skill_Match_Dashboard
		{
			displayname = "Skill_Match_Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = ' Role'\n\tytitle = ' Average of Match %'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Skill_Match'\n\txfield = 'Job_Post.Role'\n\tyfields = 'sum:Match_Percentage'\n\tquickFilters = 'Job_Post.Role'\n/>\n\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			Mathc_Calc as "Mathc_Calc"
			{
				type =  form
				form = Skill_Match

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											matchedCount = 0;
										totalSkills = input.My_Skills.size();
										if(totalSkills > 0)
										{
											// Get the selected job's AI-generated keywords.
											jobKeywords = input.Job_Post.Keyword;
											// Compare each selected skill against the keywords.
											for each  skill in input.My_Skills
											{
												if(jobKeywords.toLowerCase().contains(skill.toLowerCase()))
												{
													matchedCount = matchedCount + 1;
												}
											}
											input.Match_Percentage = (matchedCount * 100.0) / totalSkills;
										}
										else
										{
											input.Match_Percentage = 0;
										}
						)
					}
				}

			}
		}






	}
	share_settings
